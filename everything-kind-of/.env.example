# Copy this file to .env and fill in real values.
# All Vite env vars exposed to the browser MUST start with VITE_

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=everything-kind-of.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=everything-kind-of
VITE_FIREBASE_STORAGE_BUCKET=everything-kind-of.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your Express backend, e.g. http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
